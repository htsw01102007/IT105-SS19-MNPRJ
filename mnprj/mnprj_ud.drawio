        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam Monochrome true\nskinparam Shadowing false\n\nactor \&quot;Customer\&quot; as cust\nactor \&quot;Cashier\&quot; as cash\nactor \&quot;Warehouse Staff\&quot; as wh\nactor \&quot;System Admin\&quot; as admin\n\nrectangle \&quot;FastMart Enterprise System\&quot; {\n  usecase \&quot;Authenticate User\&quot; as UC_Auth\n  usecase \&quot;Lock Inventory\&quot; as UC_Lock\n  usecase \&quot;Place Online Order\&quot; as UC_PlaceOrder\n  usecase \&quot;Apply Voucher\&quot; as UC_Voucher\n  usecase \&quot;Pay via VNPay/Momo\&quot; as UC_Pay\n  usecase \&quot;POS Checkout\&quot; as UC_POS\n  usecase \&quot;Process Packing\&quot; as UC_Pack\n  usecase \&quot;Manage Product Catalog\&quot; as UC_ManagePrd\n}\n\ncust --&gt; UC_PlaceOrder\ncash --&gt; UC_POS\nwh --&gt; UC_Pack\nadmin --&gt; UC_ManagePrd\n\nUC_PlaceOrder ..&gt; UC_Auth : &lt;&lt;include&gt;&gt;\nUC_PlaceOrder ..&gt; UC_Lock : &lt;&lt;include&gt;&gt;\nUC_Voucher ..&gt; UC_PlaceOrder : &lt;&lt;extend&gt;&gt;\nUC_Pay ..&gt; UC_PlaceOrder : &lt;&lt;extend&gt;&gt;\nUC_POS ..&gt; UC_Lock : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="L9_3HGhT4kuN2f54EzNv-305">
