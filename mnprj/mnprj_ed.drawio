        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam Monochrome true\nskinparam Shadowing false\n\nentity \&quot;Users\&quot; as users {\n  * userId : String [PK]\n  --\n  username : String\n  passwordHash : String\n  fullName : String\n  phone : String\n  email : String\n  role : String\n  shippingAddr : String\n}\n\nentity \&quot;Categories\&quot; as categories {\n  * categoryId : String [PK]\n  --\n  categoryName : String\n}\n\nentity \&quot;Products\&quot; as products {\n  * productId : String [PK]\n  --\n  productName : String\n  categoryId : String [FK]\n  unitPrice : Double\n  stockQuantity : Integer\n  status : String\n}\n\nentity \&quot;Orders\&quot; as orders {\n  * orderId : String [PK]\n  --\n  customerId : String [FK]\n  orderDate : DateTime\n  totalAmount : Double\n  channel : String\n  status : String\n}\n\nentity \&quot;OrderItems\&quot; as order_items {\n  * orderId : String [PK, FK1]\n  * productId : String [PK, FK2]\n  --\n  quantity : Integer\n  price : Double\n  lineTotal : Double\n}\n\nentity \&quot;Payments\&quot; as payments {\n  * paymentId : String [PK]\n  --\n  orderId : String [FK]\n  paymentMethod : String\n  amount : Double\n  paymentStatus : String\n  transactionNo : String\n}\n\nusers ||--o{ orders\ncategories ||--o{ products\norders ||--|{ order_items\nproducts ||--o{ order_items\norders ||--|| payments\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Xt0Ma0GqSUbVHZ4BljiI-36">
